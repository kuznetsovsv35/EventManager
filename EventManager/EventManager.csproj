      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../EventManager.Infrastructure/EventManager.Infrastructure.csproj" />
    <ProjectReference Include="../EventManager.Presentation/EventManager.Presentation.csproj" />
  </ItemGroup>

</Project>
